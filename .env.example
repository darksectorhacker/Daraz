# Existing Turso database credentials
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Chromium is installed automatically during npm postinstall
PLAYWRIGHT_BROWSERS_PATH=0

# AI is optional. Gemini is primary; Groq is fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Existing admin protection
ADMIN_PASSWORD=
